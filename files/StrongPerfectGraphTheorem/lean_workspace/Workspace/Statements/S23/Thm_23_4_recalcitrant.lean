/-- **23.4**, final sentence (printed p. 142) — the closing corollary of 23.4,
stated on its own because the paper asserts it of *every* recalcitrant graph,
under no hypothesis.

PAPER: *"In particular, every recalcitrant graph belongs to `F₁₀`."*

`G` is an arbitrary finite graph, unrelated to the `G ∈ F₉` of `thm_23_4`;
*recalcitrant* is the four-bullet notion of §13. -/
theorem thm_23_4_recalcitrant (G : SimpleGraph V) (hG : SPGT.Recalcitrant G) :
    SPGT.InF10 G := by
  -- 23.4 excludes only vertices of `G \ V(C)`; `F₁₀` quantifies over all vertices.  The
  -- gap is the remark in the `InF10` doc-comment: *"no vertex of the hole itself can
  -- qualify, since a hole is induced and so each of its vertices has exactly two
  -- neighbours on it"*.  (Same argument as the `private` lemma
  -- `hole_no_three_consecutive_neighbours` of the proved `Workspace.Statements.S01.Thm_1_8_10`;
  -- it is `private` there, so it is repeated here as a local `have`.)
  have hole_no3 : ∀ (H : SimpleGraph V) (C : List V), SPGT.IsHoleList H C →
      6 ≤ SPGT.holeLength C → ∀ v : V, v ∈ C →
      ¬ ∃ x y z : V, (∃ k : ℕ, [x, y, z] <+: C.rotate k) ∧
        H.Adj v x ∧ H.Adj v y ∧ H.Adj v z := by
    rintro H C hC h6 v hv ⟨x, y, z, ⟨k, t, ht⟩, hvx, hvy, -⟩
    -- `ht : [x, y, z] ++ t = C.rotate k`, i.e. the rotated hole is `x :: y :: z :: t`.
    have hrot : (x :: y :: z :: t) = C.rotate k := ht
    have hD : SPGT.IsHoleList H (x :: y :: z :: t) := by
      rw [hrot]; exact _root_.Workspace.ProofLemmas.HoleBasics.isHoleList_rotate hC k
    have hlen : (x :: y :: z :: t).length = C.length := by
      rw [hrot, List.length_rotate]
    have h6C : 6 ≤ C.length := h6
    have hn6 : 6 ≤ (x :: y :: z :: t).length := by omega
    have hvD : v ∈ (x :: y :: z :: t) := by
      rw [hrot]; exact List.mem_rotate.mpr hv
    obtain ⟨i, hi, hvi⟩ := List.getElem_of_mem hvD
    have h0 : 0 < (x :: y :: z :: t).length := by omega
    have h1 : 1 < (x :: y :: z :: t).length := by omega
    have hx0 : (x :: y :: z :: t)[0]'h0 = x := by simp
    have hy1 : (x :: y :: z :: t)[1]'h1 = y := by simp
    have hax : H.Adj ((x :: y :: z :: t)[i]'hi) ((x :: y :: z :: t)[0]'h0) := by
      rw [hvi, hx0]; exact hvx
    have hay : H.Adj ((x :: y :: z :: t)[i]'hi) ((x :: y :: z :: t)[1]'h1) := by
      rw [hvi, hy1]; exact hvy
    have hix := (_root_.Workspace.ProofLemmas.HoleBasics.hole_adj_iff hD hi h0).mp hax
    have hiy := (_root_.Workspace.ProofLemmas.HoleBasics.hole_adj_iff hD hi h1).mp hay
    have e2 : (0 + 1) % (x :: y :: z :: t).length = 1 := Nat.mod_eq_of_lt (by omega)
    have e3 : (1 + 1) % (x :: y :: z :: t).length = 2 := Nat.mod_eq_of_lt (by omega)
    by_cases hc : i + 1 = (x :: y :: z :: t).length
    · have e1 : (i + 1) % (x :: y :: z :: t).length = 0 := by rw [hc]; simp
      rw [e1, e2] at hix
      rw [e1, e3] at hiy
      omega
    · have e1 : (i + 1) % (x :: y :: z :: t).length = i + 1 :=
        Nat.mod_eq_of_lt (by omega)
      rw [e1, e2] at hix
      rw [e1, e3] at hiy
      omega
  -- Printed p. 139 (the closing sentence of 23.2): every recalcitrant graph is in `F₉`.
  have hF9 : SPGT.InF9 G :=
    _root_.Workspace.Statements.S23.SPGT.thm_23_2_recalcitrant G hG
  -- `F₉` is complement-closed; 23.4 is stated for `G` only, and `F₁₀` asks for the
  -- condition in `G` *and* in `Ḡ`.
  have hF9c : SPGT.InF9 Gᶜ :=
    _root_.Workspace.ProofLemmas.ClassLemmas.inF9_compl.mpr hF9
  have hbsp : ¬ SPGT.AdmitsBalancedSkewPartition G := hG.2.2.2.2
  have hbspc : ¬ SPGT.AdmitsBalancedSkewPartition Gᶜ := fun h =>
    hbsp (_root_.Workspace.ProofLemmas.ClassLemmas.admitsBalancedSkewPartition_compl.mp h)
  -- 23.4: *"Let `G ∈ F₉`, admitting no balanced skew partition, and let `C` be a hole in
  -- `G` of length ≥ 6.  Then there is no vertex of `G \ V(C)` with three consecutive
  -- neighbours in `C`."*
  have h23G := thm_23_4 G hF9 hbsp
  have h23Gc := thm_23_4 Gᶜ hF9c hbspc
  refine ⟨hF9, ?_, ?_⟩
  · intro C hC h6
    rintro ⟨v, x, y, z, hpre, hvx, hvy, hvz⟩
    by_cases hv : v ∈ C
    · exact hole_no3 G C hC h6 v hv ⟨x, y, z, hpre, hvx, hvy, hvz⟩
    · exact h23G C hC h6 ⟨v, hv, x, y, z, hpre, hvx, hvy, hvz⟩
  · intro C hC h6
    rintro ⟨v, x, y, z, hpre, hvx, hvy, hvz⟩
    by_cases hv : v ∈ C
    · exact hole_no3 Gᶜ C hC h6 v hv ⟨x, y, z, hpre, hvx, hvy, hvz⟩
    · exact h23Gc C hC h6 ⟨v, hv, x, y, z, hpre, hvx, hvy, hvz⟩


end SPGT

end Workspace.Statements.S23
