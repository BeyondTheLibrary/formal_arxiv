/-- **23.5**, final sentence (printed p. 143) — the closing corollary of 23.5,
stated on its own because the paper asserts it of *every* recalcitrant graph,
under no hypothesis.

PAPER: *"In particular, for every recalcitrant graph `G`, one of `G, Ḡ` belongs to
`F₁₁`."*

The `G` of this sentence is a fresh variable, unrelated to the `G ∈ F₁₀` of
`thm_23_5`; *"one of `G, Ḡ`"* is the disjunction `InF11 G ∨ InF11 Gᶜ`, and
*recalcitrant* is the four-bullet notion of §13. -/
theorem thm_23_5_recalcitrant (G : SimpleGraph V) (hG : SPGT.Recalcitrant G) :
    SPGT.InF11 G ∨ SPGT.InF11 Gᶜ := by
  -- Printed p. 142 (the closing sentence of 23.4): every recalcitrant graph is in `F₁₀`.
  have hF10 : SPGT.InF10 G :=
    _root_.Workspace.Statements.S23.SPGT.thm_23_4_recalcitrant G hG
  -- The first bullet of *recalcitrant*: `G` is Berge, so every hole of `G` and every
  -- hole of `Ḡ` has even length.
  have hB : SPGT.Berge G := hG.1
  -- 23.5: *"`G` does not contain both a hole of length ≥ 6 and an antihole of length ≥ 6."*
  have h23 := thm_23_5 G hF10
  rw [not_and_or] at h23
  rcases h23 with hP | hQ
  · -- No hole of `G` has length ≥ 6.  A hole is even and has length ≥ 4, so every hole of
    -- `G` has length exactly 4 — i.e. every antihole of `Ḡ` has length 4; with `Ḡ ∈ F₁₀`
    -- (`F₁₀` is complement-closed) this is `Ḡ ∈ F₁₁`.
    refine Or.inr (_root_.Workspace.ProofLemmas.ClassLemmas.inF11_compl_iff.mpr ⟨hF10, ?_⟩)
    intro c hc
    have h4 : 4 ≤ c.length :=
      _root_.Workspace.ProofLemmas.HoleBasics.hole_length_ge_four hc
    have h6 : ¬ (6 ≤ c.length) := fun h => hP ⟨c, hc, h⟩
    have hev : c.length % 2 = 0 := Nat.even_iff.mp (hB.1 c hc)
    show c.length = 4
    omega
  · -- No antihole of `G` has length ≥ 6, so every antihole of `G` has length exactly 4;
    -- with `G ∈ F₁₀` this is `G ∈ F₁₁`.
    refine Or.inl ⟨hF10, ?_⟩
    intro c hc
    have hc' : SPGT.IsHoleList Gᶜ c :=
      _root_.Workspace.ProofLemmas.HoleBasics.isAntiholeList_iff.mp hc
    have h4 : 4 ≤ c.length :=
      _root_.Workspace.ProofLemmas.HoleBasics.hole_length_ge_four hc'
    have h6 : ¬ (6 ≤ c.length) := fun h => hQ ⟨c, hc, h⟩
    have hev : c.length % 2 = 0 := Nat.even_iff.mp (hB.2 c hc')
    show c.length = 4
    omega


end SPGT

