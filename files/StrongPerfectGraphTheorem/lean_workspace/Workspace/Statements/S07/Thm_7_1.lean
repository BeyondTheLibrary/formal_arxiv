variable {V : Type*} [Fintype V] [DecidableEq V]

private def thm71Restrict {U : Type*} (J : SimpleGraph U) (c x y : U) : SimpleGraph U where
  Adj a b := J.Adj a b ∧ (a = c → b = x ∨ b = y) ∧ (b = c → a = x ∨ a = y)
  symm := by
    rintro a b ⟨hJ, ha, hb⟩
    exact ⟨hJ.symm, hb, ha⟩
  loopless := ⟨fun a h => J.irrefl h.1⟩

private theorem thm71Restrict_adj {U : Type*} (J : SimpleGraph U) (c x y a b : U) :
    (thm71Restrict J c x y).Adj a b ↔
      J.Adj a b ∧ (a = c → b = x ∨ b = y) ∧ (b = c → a = x ∨ a = y) := by
  change
    (J.Adj a b ∧ (a = c → b = x ∨ b = y) ∧ (b = c → a = x ∨ a = y)) ↔
      J.Adj a b ∧ (a = c → b = x ∨ b = y) ∧ (b = c → a = x ∨ a = y)
  rfl

private theorem thm71Restrict_le {U : Type*} (J : SimpleGraph U) (c x y : U) :
    thm71Restrict J c x y ≤ J := by
  intro a b hab
  exact (thm71Restrict_adj J c x y a b).mp hab |>.1

private theorem thm71Restrict_induce_eq {U : Type*} (J : SimpleGraph U) (c x y : U)
    (A : Set U) (hc : c ∉ A) : (thm71Restrict J c x y).induce A = J.induce A := by
  ext a b
  change
    (J.Adj a.1 b.1 ∧ (a.1 = c → b.1 = x ∨ b.1 = y) ∧
        (b.1 = c → a.1 = x ∨ a.1 = y)) ↔ J.Adj a.1 b.1
  constructor
  · intro h
    exact h.1
  · intro h
    refine ⟨h, ?_, ?_⟩
    · intro hac
      exact (hc (hac ▸ a.2)).elim
    · intro hbc
      exact (hc (hbc ▸ b.2)).elim

private theorem thm71_connected_attach {U : Type*} (G : SimpleGraph U) (A : Set U) (c : U)
    (hA : (G.induce A).Connected) (x : U) (hxA : x ∈ A) (hcx : G.Adj c x) :
    (G.induce (insert c A)).Connected := by
  classical
  have hincl : ∀ a : U, a ∈ A → a ∈ insert c A :=
    fun a ha => Set.mem_insert_of_mem _ ha
  have hcmem : c ∈ insert c A := Set.mem_insert _ _
  let φ : (G.induce A) →g (G.induce (insert c A)) :=
    ⟨fun z => ⟨z.1, hincl z.1 z.2⟩, fun {_ _} h => h⟩
  have key : ∀ a : ↥(insert c A), (G.induce (insert c A)).Reachable ⟨c, hcmem⟩ a := by
    rintro ⟨a, ha⟩
    rcases Set.mem_insert_iff.mp ha with rfl | ha'
    · exact SimpleGraph.Reachable.refl _
    · have hstep : (G.induce (insert c A)).Adj ⟨c, hcmem⟩ ⟨x, hincl x hxA⟩ := hcx
      have hr : (G.induce A).Reachable ⟨x, hxA⟩ ⟨a, ha'⟩ := hA.preconnected _ _
      exact hstep.reachable.trans (hr.map φ)
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  exact ⟨⟨c, hcmem⟩, key⟩

private theorem thm71_twoConnected {U : Type*} [Fintype U] {J : SimpleGraph U}
    (hJ : IsKConnected J 3) {c x y : U} (hx : J.Adj c x) (hy : J.Adj c y) (hxy : x ≠ y) :
    IsKConnected (thm71Restrict J c x y) 2 := by
  classical
  refine ⟨by have hcard := hJ.1; omega, ?_⟩
  intro S hS
  by_cases hcS : c ∈ S
  · rw [thm71Restrict_induce_eq J c x y Sᶜ (fun hcSc => hcSc hcS)]
    exact hJ.2 S (by omega)
  · set T : Set U := insert c S with hTdef
    have hTcard : T.ncard < 3 := by
      have hle := Set.ncard_insert_le c S
      rw [hTdef]
      omega
    have hTconn : ((thm71Restrict J c x y).induce Tᶜ).Connected := by
      rw [thm71Restrict_induce_eq J c x y Tᶜ (fun hcT => hcT (Set.mem_insert c S))]
      exact hJ.2 T hTcard
    have hxyS : x ∉ S ∨ y ∉ S := by
      by_contra hboth
      push Not at hboth
      have hsub : ({x, y} : Set U) ⊆ S := by
        intro z hz
        rcases hz with hz | hz
        · exact hz ▸ hboth.1
        · rw [Set.mem_singleton_iff] at hz
          exact hz ▸ hboth.2
      have hle := Set.ncard_le_ncard hsub S.toFinite
      rw [Set.ncard_pair hxy] at hle
      omega
    obtain ⟨z, hzT, hcz⟩ :
        ∃ z : U, z ∈ Tᶜ ∧ (thm71Restrict J c x y).Adj c z := by
      rcases hxyS with hxS | hyS
      · refine ⟨x, ?_, ?_⟩
        · intro hxT
          rcases Set.mem_insert_iff.mp hxT with hxc | hxS'
          · exact hx.ne' hxc
          · exact hxS hxS'
        · apply (thm71Restrict_adj J c x y c x).mpr
          refine ⟨hx, ?_, ?_⟩
          · intro _
            exact Or.inl rfl
          · intro hxc
            exact (hx.ne' hxc).elim
      · refine ⟨y, ?_, ?_⟩
        · intro hyT
          rcases Set.mem_insert_iff.mp hyT with hyc | hyS'
          · exact hy.ne' hyc
          · exact hyS hyS'
        · apply (thm71Restrict_adj J c x y c y).mpr
          refine ⟨hy, ?_, ?_⟩
          · intro _
            exact Or.inr rfl
          · intro hyc
            exact (hy.ne' hyc).elim
    have hScompl : (Sᶜ : Set U) = insert c Tᶜ := by
      ext v
      constructor
      · intro hv
        by_cases hvc : v = c
        · exact Set.mem_insert_iff.mpr (Or.inl hvc)
        · refine Set.mem_insert_iff.mpr (Or.inr ?_)
          intro hvT
          rcases Set.mem_insert_iff.mp hvT with hvc' | hvS
          · exact hvc hvc'
          · exact hv hvS
      · intro hv
        rcases Set.mem_insert_iff.mp hv with rfl | hvT
        · exact hcS
        · intro hvS
          exact hvT (Set.mem_insert_of_mem c hvS)
    rw [hScompl]
    exact thm71_connected_attach _ _ _ hTconn z hzT hcz


/-- **7.1** (printed p. 34)

PAPER: *"Let `c₁, c₂` be adjacent vertices of a 3-connected graph `J`, and let `e, f` be
edges of `J` incident with `c₁` and different from `c₁c₂`.  There are three tracks of `J`
from `c₁` to `c₂`, pairwise vertex-disjoint except for their ends, and with first edges
`c₁c₂, e, f` respectively."*

Notes on the transcription.

* `J` is a host graph, so the objects here are **tracks** (subgraphs, not induced), given
  by the list of their vertices in order (`Tracks.IsTrackFrom`), and 3-connectedness is
  `Tracks.IsKConnected J 3`.
* Edges of `J` are elements of `J.edgeSet ⊆ Sym2 U`; *"incident with `c₁`"* is `c₁ ∈ e`, and
  *"different from `c₁c₂`"* is `e ≠ s(c₁, c₂)`.
* *"with first edge `e`"*: the track starts at `c₁`, so its first edge is `c₁w` where `w` is
  its second vertex; this is written `Q = c₁ :: w :: rest` with `s(c₁, w) = e`.
* *"pairwise vertex-disjoint except for their ends"*: a vertex on two of the three tracks is
  `c₁` or `c₂`.
* The hypothesis `e ≠ f` is **not printed**, but it is the intended reading: the paper's
  one-line proof deletes from `J` every edge incident with `c₁` except `e` and `f` and
  asserts that the result is still 2-connected, which needs `c₁` to keep degree two; and
  with `e = f` the conclusion is outright false, since the two tracks with first edge `e`
  would share their second vertex, which is neither `c₁` nor `c₂`. -/
theorem thm_7_1 {U : Type*} [Fintype U] (J : SimpleGraph U) (hJ : IsKConnected J 3)
    (c₁ c₂ : U) (hc : J.Adj c₁ c₂) (e f : Sym2 U)
    (he : e ∈ J.edgeSet) (hf : f ∈ J.edgeSet)
    (hec₁ : c₁ ∈ e) (hfc₁ : c₁ ∈ f)
    (hec : e ≠ s(c₁, c₂)) (hfc : f ≠ s(c₁, c₂)) (hef : e ≠ f) :
    ∃ Q₁ Q₂ Q₃ : List U,
      IsTrackFrom J Q₁ c₁ c₂ ∧ IsTrackFrom J Q₂ c₁ c₂ ∧ IsTrackFrom J Q₃ c₁ c₂ ∧
      (∀ v ∈ Q₁, v ∈ Q₂ → v = c₁ ∨ v = c₂) ∧
      (∀ v ∈ Q₁, v ∈ Q₃ → v = c₁ ∨ v = c₂) ∧
      (∀ v ∈ Q₂, v ∈ Q₃ → v = c₁ ∨ v = c₂) ∧
      (∃ (w : U) (rest : List U), Q₁ = c₁ :: w :: rest ∧ s(c₁, w) = s(c₁, c₂)) ∧
      (∃ (w : U) (rest : List U), Q₂ = c₁ :: w :: rest ∧ s(c₁, w) = e) ∧
      (∃ (w : U) (rest : List U), Q₃ = c₁ :: w :: rest ∧ s(c₁, w) = f) := by
  classical
  obtain ⟨x, hxe⟩ := Sym2.mem_iff_exists.mp hec₁
  obtain ⟨y, hyf⟩ := Sym2.mem_iff_exists.mp hfc₁
  have hax : J.Adj c₁ x := by
    have hxeJ : s(c₁, x) ∈ J.edgeSet := hxe ▸ he
    exact hxeJ
  have hay : J.Adj c₁ y := by
    have hyfJ : s(c₁, y) ∈ J.edgeSet := hyf ▸ hf
    exact hyfJ
  have hxc₂ : x ≠ c₂ := by
    rintro rfl
    exact hec hxe
  have hyc₂ : y ≠ c₂ := by
    rintro rfl
    exact hfc hyf
  have hxy : x ≠ y := by
    rintro rfl
    exact hef (hxe.trans hyf.symm)
  set J' : SimpleGraph U := thm71Restrict J c₁ x y with hJ'def
  have hJ'2 : IsKConnected J' 2 := thm71_twoConnected hJ hax hay hxy
  obtain ⟨P, Q, _hPQ, hP, hQ, hdisj⟩ :=
    Workspace.ProofLemmas.TwoInternallyDisjointTracksInTwoConnectedGraph.twoInternallyDisjointTracksInTwoConnectedGraph J' c₁ c₂ hc.ne hJ'2
  have split : ∀ R : List U, IsTrackFrom J' R c₁ c₂ →
      ∃ (w : U) (rest : List U), R = c₁ :: w :: rest ∧ J'.Adj c₁ w := by
    intro R hR
    obtain ⟨hRlist, hRhead, hRlast⟩ := hR
    match R, hRhead with
    | (a :: t), hRhead =>
      have hac : a = c₁ := by
        rw [List.head?_cons, Option.some_inj] at hRhead
        exact hRhead
      subst a
      match t with
      | [] =>
        rw [List.getLast?_singleton, Option.some_inj] at hRlast
        exact absurd hRlast hc.ne
      | (b :: t') =>
        refine ⟨b, t', rfl, ?_⟩
        have hadj := hRlist.2.2 0 (by simp)
        simpa using hadj
  obtain ⟨p2, prest, hPeq, hPadj⟩ := split P hP
  obtain ⟨q2, qrest, hQeq, hQadj⟩ := split Q hQ
  have hp2xy : p2 = x ∨ p2 = y :=
    ((thm71Restrict_adj J c₁ x y c₁ p2).mp (by simpa [hJ'def] using hPadj)).2.1 rfl
  have hq2xy : q2 = x ∨ q2 = y :=
    ((thm71Restrict_adj J c₁ x y c₁ q2).mp (by simpa [hJ'def] using hQadj)).2.1 rfl
  have hp2c₁ : p2 ≠ c₁ := (hPadj.ne).symm
  have hp2c₂ : p2 ≠ c₂ := by
    rcases hp2xy with rfl | rfl
    · exact hxc₂
    · exact hyc₂
  have hp2mem : p2 ∈ P := by
    rw [hPeq]
    simp
  have hq2mem : q2 ∈ Q := by
    rw [hQeq]
    simp
  have hp2q2 : p2 ≠ q2 := by
    intro hpq
    rcases hdisj p2 hp2mem (hpq ▸ hq2mem) with hcase₁ | hcase₂
    · exact hp2c₁ hcase₁
    · exact hp2c₂ hcase₂
  have hJ'leJ : J' ≤ J := by
    simpa only [hJ'def] using thm71Restrict_le J c₁ x y
  have lift : ∀ R : List U, IsTrackFrom J' R c₁ c₂ → IsTrackFrom J R c₁ c₂ := by
    intro R hR
    rcases hR with ⟨⟨hRne, hRnodup, hRadj⟩, hRhead, hRlast⟩
    refine ⟨⟨hRne, hRnodup, ?_⟩, hRhead, hRlast⟩
    intro i hi
    exact hJ'leJ (hRadj i hi)
  have hPJ : IsTrackFrom J P c₁ c₂ := lift P hP
  have hQJ : IsTrackFrom J Q c₁ c₂ := lift Q hQ
  have hedge : IsTrackFrom J [c₁, c₂] c₁ c₂ := by
    refine ⟨⟨by simp, by simp [hc.ne], ?_⟩, rfl, rfl⟩
    intro i hi
    have hi0 : i = 0 := by
      simp at hi
      omega
    subst i
    simpa using hc
  have htriv : ∀ (R : List U), ∀ v ∈ [c₁, c₂], v ∈ R → v = c₁ ∨ v = c₂ := by
    intro R v hv _
    simpa using hv
  rcases hp2xy with hpx | hpy
  · have hqy : q2 = y := by
      rcases hq2xy with hqx | hqy
      · exact absurd (hpx.trans hqx.symm) hp2q2
      · exact hqy
    refine ⟨[c₁, c₂], P, Q, hedge, hPJ, hQJ, htriv P, htriv Q, hdisj,
      ⟨c₂, [], rfl, rfl⟩, ⟨p2, prest, hPeq, ?_⟩, ⟨q2, qrest, hQeq, ?_⟩⟩
    · rw [hpx, hxe]
    · rw [hqy, hyf]
  · have hqx : q2 = x := by
      rcases hq2xy with hqx | hqy
      · exact hqx
      · exact absurd (hpy.trans hqy.symm) hp2q2
    refine ⟨[c₁, c₂], Q, P, hedge, hQJ, hPJ, htriv Q, htriv P,
      (fun v hvQ hvP => hdisj v hvP hvQ),
      ⟨c₂, [], rfl, rfl⟩, ⟨q2, qrest, hQeq, ?_⟩, ⟨p2, prest, hPeq, ?_⟩⟩
    · rw [hqx, hxe]
    · rw [hpy, hyf]


end SPGT

