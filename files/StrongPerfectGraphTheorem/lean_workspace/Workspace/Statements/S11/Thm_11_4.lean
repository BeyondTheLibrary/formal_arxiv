/-!
# Section 11 — Step-connected strips

The five numbered statements 11.1–11.5 of Chudnovsky–Robertson–Seymour–Thomas,
*The Strong Perfect Graph Theorem* (published/Annals version, printed pages 63–68),
transcribed from `paper/pdf/S11_Step_connected_strips.md`.

All the defined terms used here are imported and never restated: *rung*, *step*,
*step-connected strip*, *left-star*, *right-star*, *banister* and *1-breaker* come from
`Workspace.Types.Staircases`; *even prism* from `Workspace.Types.Prisms`; *appearance* and
*(non)degenerate appearance* from `Workspace.Types.Appearances`; *Berge*, *path*, *length*,
*interior*, *complete*/*anticomplete* from `Workspace.Types.Core`; *balanced skew partition*
from `Workspace.Types.Decompositions`.

Encoding conventions (see `paper/spec/CONVENTIONS.md`):

* a strip `S = (A, C, B)` is carried by its three vertex sets `A C B : Set V`, in the printed
  order, and `V(S)` is `A ∪ B ∪ C`;
* a path is the list of its vertices in order, `V(P)` for such a list `P` is `{v | v ∈ P}`,
  `P*` is `SPGT.interior P` and the length of `P` is `pathLength P`;
* *"`P` is a path in `G \ X` from `u` to `v`"* is `IsPathFrom G P u v` together with
  `∀ w ∈ P, w ∉ X`;
* *"there are no edges between `X` and `Y`"* is `SPGT.Anticomplete G X Y`;
* *"there is no nondegenerate appearance of `K₄` in `G`"* is spelled out as
  `¬ ∃ n (H : SimpleGraph (Fin n)) (K : Set V), IsAppearance G K₄ H K ∧
  NondegenerateAppearance K₄ H`, and *"there is no appearance of `K₄` in `G`"* — a strictly
  stronger hypothesis, used in 11.2, 11.4 and 11.5 — is `¬ Appears G K₄`, where `K₄` is
  `(⊤ : SimpleGraph (Fin 4))`;
* *"there is no even prism in `G`"* is: no three paths of `G` form an even prism.

Published-vs-draft note: the conclusion of **11.3** is the published one, *"every rung of the
strip has odd length, **and so does `R₀`**"*; the arXiv v1 draft omits the second clause and is
strictly weaker than what its own 11.4 cites it for.
-/

set_option autoImplicit false

namespace Workspace.Statements.S11

open Workspace.Types.Core Workspace.Types.Core.SPGT
open Workspace.Types.Prisms Workspace.Types.Prisms.SPGT
open Workspace.Types.Staircases Workspace.Types.Staircases.SPGT
open Workspace.Types.Appearances Workspace.Types.Appearances.SPGT
open Workspace.Types.Decompositions Workspace.Types.Decompositions.SPGT

namespace SPGT

variable {V : Type*} [Fintype V] [DecidableEq V]


/-- **11.4** (printed p. 66)

PAPER: *"Let `G` be a Berge graph, such that there is no appearance of `K₄` in `G` and no even
prism in `G`.  Let `S = (A, C, B)` be a step-connected strip in `G`.  Let
`F ⊆ V(G) \ (A ∪ B ∪ C)` be connected, such that there are no edges between `F` and
`A ∪ B ∪ C`.  There is no anticonnected set `Q ⊆ V(G) \ (A ∪ B ∪ C ∪ F)` such that:*

* *some right-star has a neighbour in `F` and a nonneighbour in `Q`,*
* *some vertex in `B` has a nonneighbour in `Q`,*
* *some left-star with a neighbour in `F` is `Q`-complete,*
* *every vertex in `Q` has a neighbour in `F`,*
* *every vertex in `Q` has a neighbour in `A ∪ B ∪ C`, and*
* *no vertex in `Q` is a left-star."*

The six bullets are listed in the printed order.  No banister is assumed. -/
theorem thm_11_4 (G : SimpleGraph V) (hG : Berge G)
    (hK4 : ¬ Appears G (⊤ : SimpleGraph (Fin 4)))
    (hprism : ¬ ∃ (a b : Fin 3 → V) (R₁ R₂ R₃ : List V), IsEvenPrism G a b R₁ R₂ R₃)
    (A C B : Set V) (hS : StepConnected G A C B)
    (F : Set V) (hF : F ⊆ (A ∪ B ∪ C)ᶜ) (hFconn : ConnectedSet G F)
    (hFedges : SPGT.Anticomplete G F (A ∪ B ∪ C)) :
    ¬ ∃ Q : Set V, Q ⊆ ((A ∪ B ∪ C) ∪ F)ᶜ ∧ AnticonnectedSet G Q ∧
      (∃ w : V, IsRightStar G A C B w ∧ (∃ f ∈ F, G.Adj w f) ∧ (∃ q ∈ Q, ¬ G.Adj w q)) ∧
      (∃ b ∈ B, ∃ q ∈ Q, ¬ G.Adj b q) ∧
      (∃ u : V, IsLeftStar G A C B u ∧ (∃ f ∈ F, G.Adj u f) ∧ SPGT.VertexComplete G u Q) ∧
      (∀ q ∈ Q, ∃ f ∈ F, G.Adj q f) ∧
      (∀ q ∈ Q, ∃ w ∈ A ∪ B ∪ C, G.Adj q w) ∧
      (∀ q ∈ Q, ¬ IsLeftStar G A C B q) := by
  classical
  rintro ⟨Q, hQout, hQanti,
    ⟨b₀, hb₀star, hb₀Fnbr, hb₀bad⟩,
    hBbad,
    ⟨a₀, ha₀star, ha₀Fnbr, ha₀Q⟩,
    hQFnbr, hQSnbr, hQnotLeft⟩
  have hFout : ∀ x ∈ F, x ∉ A ∪ B ∪ C := by
    intro x hx
    exact hF hx
  obtain ⟨aA, haA⟩ := hS.2.1.1
  obtain ⟨bB, hbB⟩ := hS.2.1.2
  have ha₀notF : a₀ ∉ F :=
    Workspace.ProofLemmas.Thm114Aux.star_notMem_F hFedges
      (Or.inl (Or.inl haA)) (ha₀star.2.1 aA haA)
  have hb₀notF : b₀ ∉ F :=
    Workspace.ProofLemmas.Thm114Aux.star_notMem_F hFedges
      (Or.inl (Or.inr hbB)) (hb₀star.2.1 bB hbB)
  have ha₀b₀ : a₀ ≠ b₀ := by
    intro he
    exact hb₀star.2.2 aA (Or.inl haA) (he ▸ ha₀star.2.1 aA haA)

  -- The first sentence of the printed proof: join the two stars through `F`.
  obtain ⟨R₀, hban, hR₀F⟩ :=
    Workspace.ProofLemmas.Thm114Aux.banister_through_F hFout hFedges hFconn
      ha₀star hb₀star hS.2.1.1 hS.2.1.2 ha₀Fnbr hb₀Fnbr
  have hodd := Workspace.Statements.S11.SPGT.thm_11_3
    G hG hprism A C B hS a₀ b₀ R₀ hban

  -- Choose the minimal antipath `q₁-...-qₙ` from the next sentence of the proof.
  obtain ⟨qs, q₁, qn, hqs, hqsQ, hb₀q₁, hBqn, hb₀tail, hBdrop⟩ :=
    Workspace.ProofLemmas.Thm114Antipath.exists_minimal_antipath Q B b₀
      hQanti hb₀bad hBbad
  have hq₁Q : q₁ ∈ Q :=
    hqsQ q₁ (Workspace.ProofLemmas.PathBasics.head_mem hqs.2.1)
  have hqnQ : qn ∈ Q :=
    hqsQ qn (Workspace.ProofLemmas.PathBasics.getLast_mem hqs.2.2)
  have hqnS : qn ∉ A ∪ B ∪ C := by
    intro hmem
    exact hQout hqnQ (Or.inl hmem)
  have hqnF : qn ∉ F := by
    intro hmem
    exact hQout hqnQ (Or.inr hmem)
  have hqna₀ : qn ≠ a₀ := (ha₀Q qn hqnQ).ne.symm

  -- A path from `qₙ` to `b₀`, with interior in `F`, is the path used in 11.1.
  obtain ⟨P, hP, hPintF⟩ :=
    Workspace.ProofLemmas.MinimalConnectedIsPath.exists_path_interior_in
      hFconn hqnF hb₀notF (hQFnbr qn hqnQ) hb₀Fnbr
  have hPavoid : ∀ x ∈ P, x ∉ (A ∪ B ∪ C) ∪ ({a₀} : Set V) :=
    Workspace.ProofLemmas.Thm114Aux.path_avoid hFout hP hPintF hqnS hb₀star.1
      hqna₀ ha₀b₀.symm ha₀notF
  have hPintAnti : SPGT.Anticomplete G {x : V | x ∈ SPGT.interior P}
      (A ∪ B ∪ C) := by
    intro x hx y hy
    exact hFedges x (hPintF x hx) y hy

  let B₁ : Set V := {b : V | b ∈ B ∧ G.Adj qn b}
  let B₂ : Set V := {b : V | b ∈ B ∧ ¬ G.Adj qn b}
  have hB₂ne : B₂.Nonempty := by
    obtain ⟨b, hb, hbad⟩ := hBqn
    exact ⟨b, hb, fun h => hbad h.symm⟩
  have hK4nondeg : ¬ ∃ (n : ℕ) (H : SimpleGraph (Fin n)) (K : Set V),
      IsAppearance G (⊤ : SimpleGraph (Fin 4)) H K ∧
        NondegenerateAppearance (⊤ : SimpleGraph (Fin 4)) H := by
    rintro ⟨n, H, K, happ, -⟩
    exact hK4 ⟨n, H, K, happ⟩
  have hB₁ne : B₁.Nonempty := by
    by_contra hB₁empty
    have hqnB : SPGT.VertexAnticomplete G qn B := by
      intro b hb hadj
      exact hB₁empty ⟨b, hb, hadj⟩
    obtain ⟨x, hxS, hqnx⟩ := hQSnbr qn hqnQ
    have hqnAC : ∃ x ∈ A ∪ C, G.Adj qn x := by
      refine ⟨x, ?_, hqnx⟩
      rcases hxS with (hxA | hxB) | hxC
      · exact Or.inl hxA
      · exact (hqnB x hxB hqnx).elim
      · exact Or.inr hxC
    exact hQnotLeft qn hqnQ
      (Workspace.Statements.S11.SPGT.thm_11_1 G hG hK4nondeg A C B hS
        a₀ b₀ R₀ hban qn hqnS hqnAC hqnB P hP hPavoid hPintAnti)
  have hBunion : B₁ ∪ B₂ = B := by
    ext b
    simp only [B₁, B₂, Set.mem_union, Set.mem_setOf_eq]
    tauto
  have hBdisj : Disjoint B₁ B₂ := by
    rw [Set.disjoint_left]
    intro b hb₁ hb₂
    exact hb₂.2 hb₁.2
  obtain ⟨a₁, R₁, b₁, a₂, R₂, b₂, hstep, hend₁, hend₂⟩ :=
    hS.2.2.2.2 B₁ B₂ (Or.inr hBunion) hBdisj hB₁ne hB₂ne
  have hb₁B₁ : b₁ ∈ B₁ := by
    rcases hend₁ with ha₁B₁ | hb₁B₁
    · exact (Set.disjoint_left.mp hS.1.1 hstep.1.2.1 ha₁B₁.1).elim
    · exact hb₁B₁
  have hb₂B₂ : b₂ ∈ B₂ := by
    rcases hend₂ with ha₂B₂ | hb₂B₂
    · exact (Set.disjoint_left.mp hS.1.1 hstep.2.1.2.1 ha₂B₂.1).elim
    · exact hb₂B₂
  have hb₁B : b₁ ∈ B := hb₁B₁.1
  have hb₂B : b₂ ∈ B := hb₂B₂.1

  -- Claim (1): the minimal antipath has at least two vertices.
  have hlen2 : 2 ≤ qs.length := by
    by_contra hshort
    have hpos := Workspace.ProofLemmas.PathBasics.path_length_pos hqs.1
    have hlen1 : qs.length = 1 := by omega
    obtain ⟨q, hshape⟩ := List.length_eq_one_iff.mp hlen1
    have hq₁eq : q = q₁ := by simpa [hshape] using hqs.2.1
    have hqneq : q = qn := by simpa [hshape] using hqs.2.2
    have heq : q₁ = qn := hq₁eq.symm.trans hqneq
    exact Workspace.ProofLemmas.Thm114ClaimOne.thm114_claim_one
      hG hK4 hprism A C B F hFout hFconn hFedges a₀ b₀ R₀ hban hR₀F hb₀Fnbr
      a₁ b₁ a₂ b₂ R₁ R₂ hstep qn hqnS hqnF (hQFnbr qn hqnQ)
      (ha₀Q qn hqnQ) hb₁B₁.2.symm (heq ▸ hb₀q₁)
      (fun h => hb₂B₂.2 h.symm)

  have hqsS : ∀ x ∈ qs, x ∉ A ∪ B ∪ C := by
    intro x hx hmem
    exact hQout (hqsQ x hx) (Or.inl hmem)
  have hqsF : ∀ x ∈ qs, x ∉ F := by
    intro x hx hmem
    exact hQout (hqsQ x hx) (Or.inr hmem)
  have hmemTail : ∀ x : V, x ∈ qs.tail ↔ x ∈ qs ∧ x ≠ q₁ := by
    intro x
    constructor
    · intro hx
      refine ⟨List.mem_of_mem_tail hx, ?_⟩
      intro he
      cases qs with
      | nil => exact hqs.1.1 rfl
      | cons y ys =>
        have hy : y = q₁ := by simpa using hqs.2.1
        subst y
        exact (List.nodup_cons.mp hqs.1.2.1).1 (he ▸ hx)
    · rintro ⟨hx, hxne⟩
      cases qs with
      | nil => exact (hqs.1.1 rfl).elim
      | cons y ys =>
        have hy : y = q₁ := by simpa using hqs.2.1
        subst y
        simp only [List.tail_cons, List.mem_cons] at ⊢ hx
        exact hx.resolve_left hxne
  have hq₁b₀ : q₁ ≠ b₀ := by
    intro he
    have htail : (qs[1]'(by omega)) ∈ qs.tail := by
      have hi : 0 < qs.tail.length := by simp; omega
      have hm := List.getElem_mem (l := qs.tail) (n := 0) hi
      simpa only [List.getElem_tail] using hm
    have hc := Workspace.ProofLemmas.PathBasics.path_adj_succ hqs.1 (i := 0) (by omega)
    have hzero : qs[0]'(by omega) = q₁ :=
      Workspace.ProofLemmas.PathBasics.getElem_zero_of_head? hqs.2.1 (by omega)
    have hc' : Gᶜ.Adj q₁ (qs[1]'(by omega)) := by simpa [hzero] using hc
    exact hc'.2 (by rw [he]; exact hb₀tail _ htail)
  have hqsR₀ : ∀ x ∈ qs, x ∉ R₀ := by
    intro x hxq hxR
    have hxQ := hqsQ x hxq
    by_cases hxa : x = a₀
    · exact hQnotLeft x hxQ (hxa ▸ ha₀star)
    by_cases hxb : x = b₀
    · by_cases hx₁ : x = q₁
      · exact hq₁b₀ (hx₁.symm.trans hxb)
      · have hadj := hb₀tail x ((hmemTail x).2 ⟨hxq, hx₁⟩)
        rw [hxb] at hadj
        exact G.irrefl hadj
    · exact hqsF x hxq
        (hR₀F x ((Workspace.ProofLemmas.PathBasics.mem_interior_iff_of_pathFrom hban.1).2
          ⟨hxR, hxa, hxb⟩))

  have hlast : qs.getLast hqs.1.1 = qn := by
    have h := hqs.2.2
    rw [List.getLast?_eq_some_getLast hqs.1.1] at h
    exact Option.some_injective _ h
  have hb₁qs : ∀ x ∈ qs, G.Adj b₁ x := by
    intro x hx
    by_cases he : x = qn
    · exact he ▸ hb₁B₁.2.symm
    · have hxdrop : x ∈ qs.dropLast :=
        (Workspace.ProofLemmas.PathBasics.mem_dropLast_iff hqs.1.2.1 hqs.1.1).2
          ⟨hx, by simpa [hlast] using he⟩
      exact (hBdrop x hxdrop b₁ hb₁B).symm

  -- Claim (2), obtained exactly from 2.6 and 2.7.1.
  let X : Set V := insert b₀ {x : V | x ∈ qs}
  have hSFX : A ∪ B ∪ C ⊆ (F ∪ X)ᶜ := by
    intro x hxS hx
    rcases hx with hxF | hxX
    · exact hFout x hxF hxS
    · rcases hxX with rfl | hxqs
      · exact hb₀star.1 hxS
      · exact hqsS x hxqs hxS
  have hFX : Disjoint F X := by
    rw [Set.disjoint_left]
    intro x hxF hxX
    rcases hxX with rfl | hxqs
    · exact hb₀notF hxF
    · exact hqsF x hxqs hxF
  have hXnbr : ∀ x ∈ X, ∃ f ∈ F, G.Adj x f := by
    intro x hx
    rcases hx with rfl | hxqs
    · exact hb₀Fnbr
    · exact hQFnbr x (hqsQ x hxqs)
  have hb₁S : b₁ ∈ A ∪ B ∪ C := Or.inl (Or.inr hb₁B)
  have hb₁FX : b₁ ∉ F ∪ X := by
    rintro (hb₁F | hb₁X)
    · exact hFout b₁ hb₁F hb₁S
    · rcases hb₁X with hb₁b₀ | hb₁qs'
      · exact hb₀star.1 (hb₁b₀.symm ▸ hb₁S)
      · exact hqsS b₁ hb₁qs' hb₁S
  have hb₁X : SPGT.VertexComplete G b₁ X := by
    intro x hx
    rcases hx with rfl | hxqs
    · exact (hb₀star.2.1 b₁ hb₁B).symm
    · exact hb₁qs x hxqs
  have hb₁F : SPGT.VertexAnticomplete G b₁ F := by
    intro f hf hadj
    exact hFedges f hf b₁ hb₁S hadj.symm
  have hbal : SPGT.Balanced G (A ∪ B ∪ C) X :=
    Workspace.ProofLemmas.Thm114Balanced.balanced_of_complete_star hG
      (A ∪ B ∪ C) F X hFconn hFedges hSFX hFX hXnbr b₁ hb₁FX hb₁X hb₁F

  exact Workspace.ProofLemmas.Thm114Endgame.thm114_endgame hG A C B
    a₀ b₀ R₀ hban hodd.2 a₁ b₁ a₂ b₂ R₁ R₂ hstep
    (hodd.1 a₂ R₂ b₂ hstep.2.1) qs q₁ qn hqs hlen2 hqsS hqsR₀
    (fun x hx => ha₀Q x (hqsQ x hx)) hb₁qs hb₀q₁ hb₀tail
    (fun h => hb₂B₂.2 h.symm) (fun x hx => (hBdrop x hx b₂ hb₂B).symm)
    (by simpa [X] using hbal)


end SPGT

end Workspace.Statements.S11
