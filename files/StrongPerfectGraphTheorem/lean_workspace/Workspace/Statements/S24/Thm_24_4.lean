/-- **24.4** (printed p. 144), introduced by *"The next is a strengthening of
17.1."*

PAPER: *"Let `G ∈ F₁₁`.  Let `X₁, X₂, X₃` be disjoint nonempty anticonnected sets,
complete to each other.  Let `F ⊆ V(G) \ (X₁ ∪ X₂ ∪ X₃)` be connected, such that for
`i = 1,2,3` there is an `Xᵢ`-complete vertex in `F`.  Then there is a vertex in `F`
complete to two of `X₁, X₂, X₃`."*

Transcription notes.

* *"disjoint"* for three sets is pairwise disjointness (spelled out as in 24.7,
  which prints *"pairwise disjoint"*).
* *"complete to each other"* is `Complete G Xᵢ Xⱼ` for the three pairs.
* *"`F ⊆ V(G) \ (X₁ ∪ X₂ ∪ X₃)`"* is `F ⊆ (X₁ ∪ X₂ ∪ X₃)ᶜ`, and *"connected"* is
  `ConnectedSet`.
* Note that 24.4, unlike 24.5 and 24.7, does **not** assume that `G` fails to
  admit a balanced skew partition.
* *"a vertex in `F` complete to two of `X₁, X₂, X₃`"* is the three-way disjunction
  over the pairs `{X₁,X₂}`, `{X₁,X₃}`, `{X₂,X₃}`. -/
theorem thm_24_4 (G : SimpleGraph V) (hG : InF11 G)
    (X₁ X₂ X₃ : Set V)
    (hd₁₂ : Disjoint X₁ X₂) (hd₁₃ : Disjoint X₁ X₃) (hd₂₃ : Disjoint X₂ X₃)
    (hne₁ : X₁.Nonempty) (hne₂ : X₂.Nonempty) (hne₃ : X₃.Nonempty)
    (ha₁ : AnticonnectedSet G X₁) (ha₂ : AnticonnectedSet G X₂)
    (ha₃ : AnticonnectedSet G X₃)
    (hc₁₂ : Complete G X₁ X₂) (hc₁₃ : Complete G X₁ X₃) (hc₂₃ : Complete G X₂ X₃)
    (F : Set V) (hF : F ⊆ (X₁ ∪ X₂ ∪ X₃)ᶜ) (hFconn : ConnectedSet G F)
    (hF₁ : ∃ f ∈ F, VertexComplete G f X₁)
    (hF₂ : ∃ f ∈ F, VertexComplete G f X₂)
    (hF₃ : ∃ f ∈ F, VertexComplete G f X₃) :
    ∃ f ∈ F,
      (VertexComplete G f X₁ ∧ VertexComplete G f X₂) ∨
      (VertexComplete G f X₁ ∧ VertexComplete G f X₃) ∨
      (VertexComplete G f X₂ ∧ VertexComplete G f X₃) := by
  classical
  by_contra hcon
  have hnotwo : ∀ f ∈ F, ¬ (VertexComplete G f X₁ ∧ VertexComplete G f X₂) ∧
      ¬ (VertexComplete G f X₁ ∧ VertexComplete G f X₃) ∧
      ¬ (VertexComplete G f X₂ ∧ VertexComplete G f X₃) := by
    intro f hf
    exact ⟨fun h => hcon ⟨f, hf, Or.inl h⟩, fun h => hcon ⟨f, hf, Or.inr (Or.inl h)⟩,
      fun h => hcon ⟨f, hf, Or.inr (Or.inr h)⟩⟩
  obtain ⟨X, hX0, hX1, hX2⟩ : ∃ X : Fin 3 → Set V, X 0 = X₁ ∧ X 1 = X₂ ∧ X 2 = X₃ :=
    ⟨![X₁, X₂, X₃], rfl, rfl, rfl⟩
  have hXcases : ∀ l : Fin 3,
      (l = 0 ∧ X l = X₁) ∨ (l = 1 ∧ X l = X₂) ∨ (l = 2 ∧ X l = X₃) := by
    intro l
    fin_cases l
    · exact Or.inl ⟨rfl, hX0⟩
    · exact Or.inr (Or.inl ⟨rfl, hX1⟩)
    · exact Or.inr (Or.inr ⟨rfl, hX2⟩)
  have hcompsymm : ∀ A B : Set V, Complete G A B → Complete G B A :=
    fun A B h b hb a ha => (h a ha b hb).symm
  have hXdisj : ∀ l₁ l₂ : Fin 3, l₁ ≠ l₂ → Disjoint (X l₁) (X l₂) := by
    intro l₁ l₂ hl
    rcases hXcases l₁ with ⟨e1, f1⟩ | ⟨e1, f1⟩ | ⟨e1, f1⟩ <;>
      rcases hXcases l₂ with ⟨e2, f2⟩ | ⟨e2, f2⟩ | ⟨e2, f2⟩ <;>
      rw [f1, f2] <;>
      first
        | exact absurd (e1.trans e2.symm) hl
        | exact hd₁₂ | exact hd₁₃ | exact hd₂₃
        | exact hd₁₂.symm | exact hd₁₃.symm | exact hd₂₃.symm
  have hXne : ∀ l : Fin 3, (X l).Nonempty := by
    intro l
    rcases hXcases l with ⟨-, f⟩ | ⟨-, f⟩ | ⟨-, f⟩ <;> rw [f]
    · exact hne₁
    · exact hne₂
    · exact hne₃
  have hXanti : ∀ l : Fin 3, AnticonnectedSet G (X l) := by
    intro l
    rcases hXcases l with ⟨-, f⟩ | ⟨-, f⟩ | ⟨-, f⟩ <;> rw [f]
    · exact ha₁
    · exact ha₂
    · exact ha₃
  have hXcomp : ∀ l₁ l₂ : Fin 3, l₁ ≠ l₂ → Complete G (X l₁) (X l₂) := by
    intro l₁ l₂ hl
    rcases hXcases l₁ with ⟨e1, f1⟩ | ⟨e1, f1⟩ | ⟨e1, f1⟩ <;>
      rcases hXcases l₂ with ⟨e2, f2⟩ | ⟨e2, f2⟩ | ⟨e2, f2⟩ <;>
      rw [f1, f2] <;>
      first
        | exact absurd (e1.trans e2.symm) hl
        | exact hc₁₂ | exact hc₁₃ | exact hc₂₃
        | exact hcompsymm _ _ hc₁₂ | exact hcompsymm _ _ hc₁₃ | exact hcompsymm _ _ hc₂₃
  have hmemF : (fun S : Set V => S ⊆ F ∧ ConnectedSet G S ∧
      ∀ l : Fin 3, ∃ w ∈ S, VertexComplete G w (X l)) F := by
    refine ⟨subset_rfl, hFconn, ?_⟩
    intro l
    rcases hXcases l with ⟨-, f⟩ | ⟨-, f⟩ | ⟨-, f⟩ <;> rw [f]
    · exact hF₁
    · exact hF₂
    · exact hF₃
  obtain ⟨S, ⟨hSF, hSconn, hSmeet⟩, hSmin⟩ :=
    Workspace.ProofLemmas.ExtremalChoice.exists_min_nat
      (fun S : Set V => S ⊆ F ∧ ConnectedSet G S ∧
        ∀ l : Fin 3, ∃ w ∈ S, VertexComplete G w (X l))
      Set.ncard ⟨F, hmemF⟩
  have hFXS : ∀ w ∈ S, ∀ l : Fin 3, w ∉ X l := by
    intro w hw l
    have hw' : w ∉ X₁ ∪ X₂ ∪ X₃ := hF (hSF hw)
    rcases hXcases l with ⟨-, f⟩ | ⟨-, f⟩ | ⟨-, f⟩ <;> rw [f]
    · exact fun h => hw' (Or.inl (Or.inl h))
    · exact fun h => hw' (Or.inl (Or.inr h))
    · exact fun h => hw' (Or.inr h)
  have hnoS : ∀ w ∈ S, ∀ l₁ l₂ : Fin 3, l₁ ≠ l₂ →
      ¬ (VertexComplete G w (X l₁) ∧ VertexComplete G w (X l₂)) := by
    rintro w hw l₁ l₂ hl ⟨h1, h2⟩
    obtain ⟨n12, n13, n23⟩ := hnotwo w (hSF hw)
    rcases hXcases l₁ with ⟨e1, f1⟩ | ⟨e1, f1⟩ | ⟨e1, f1⟩ <;>
      rcases hXcases l₂ with ⟨e2, f2⟩ | ⟨e2, f2⟩ | ⟨e2, f2⟩ <;>
      rw [f1] at h1 <;> rw [f2] at h2 <;>
      first
        | exact hl (e1.trans e2.symm)
        | exact n12 ⟨h1, h2⟩ | exact n13 ⟨h1, h2⟩ | exact n23 ⟨h1, h2⟩
        | exact n12 ⟨h2, h1⟩ | exact n13 ⟨h2, h1⟩ | exact n23 ⟨h2, h1⟩
  have hSminimal : ∀ S' : Set V, S' ⊆ S → ConnectedSet G S' →
      (∀ l : Fin 3, ∃ w ∈ S', VertexComplete G w (X l)) → S.ncard ≤ S'.ncard := by
    intro S' hsub hconn hmeet
    exact hSmin S' ⟨hsub.trans hSF, hconn, hmeet⟩
  rcases Workspace.Types.Thm244Trichotomy.minimalConnectedThreeTerminal G S
      (fun l => {w : V | VertexComplete G w (X l)}) hSconn hSmeet hnoS hSminimal with
    ⟨v, u, P, hsp⟩ | ⟨v, u, P, hsp⟩ | ⟨i, j, k, P, a, b, hsp⟩
  · exact Workspace.ProofLemmas.Thm244Case1.case1_refute
      G hG X hXdisj hXne hXanti hXcomp S v u P hsp
  · exact Workspace.Types.Thm244Case2.case2_refute
      G hG X hXdisj hXne hXanti hXcomp S hFXS v u P hsp
  · exact Workspace.Types.Thm244Case3.case3_refute
      G hG X hXdisj hXne hXanti hXcomp S hFXS hnoS i j k P a b hsp


end SPGT

end Workspace.Statements.S24
