    simp only [pathLength] at hpathPar01
    omega
  have hRlenPar02 : (R 0).length % 2 = (R 2).length % 2 := by
    simp only [pathLength] at hpathPar02
    omega
  have htotalEven : Even ((R 0).length + (R 1).length + 2 * f.length) := by
    rw [Nat.even_iff]
    omega
  have hsum : leftLen + rightLen =
      (R 0).length + (R 1).length + 2 * f.length := by
    dsimp only [leftLen, rightLen]
    omega
  have hleft4 : 4 ≤ leftLen := by
    by_contra hnot
    have hleft3 : leftLen = 3 := by
      dsimp only [leftLen] at hnot ⊢
      omega
    by_cases hr4 : 4 ≤ rightLen
    · have hre := hrightEven hr4
      rw [Nat.even_iff] at hre htotalEven
      have htot : (leftLen + rightLen) % 2 = 0 := by rw [hsum]; exact htotalEven
      omega
    · have hright3 : rightLen = 3 := by
        dsimp only [rightLen] at hr4 ⊢
        omega
      have hk0one : k0 = 1 := by dsimp only [leftLen] at hleft3; omega
      have hk1one : k1 = 1 := by dsimp only [leftLen] at hleft3; omega
      have hfone : f.length = 1 := by dsimp only [leftLen] at hleft3; omega
      have hR0eq : (R 0).length = 2 := by
        dsimp only [rightLen] at hright3
        omega
      have hR1eq : (R 1).length = 2 := by
        dsimp only [rightLen] at hright3
        omega
      have hr0La : (R 0)[k0 - 1]'(by omega) = a 0 := by
        have hhead := Workspace.ProofLemmas.PathBasics.getElem_zero_of_head?
          (hR 0).2.1 (show 0 < (R 0).length by omega)
        simpa [hk0one] using hhead
      have hr0Rb : (R 0)[k0]'hk0R = b 0 := by
        have hlast := Workspace.ProofLemmas.PathBasics.getElem_last_of_getLast?
          (hR 0).2.2 (show 0 < (R 0).length by omega)
        simpa only [hk0one, hR0eq, Nat.reduceSub] using hlast
      have hr1La : (R 1)[k1 - 1]'(by omega) = a 1 := by
        have hhead := Workspace.ProofLemmas.PathBasics.getElem_zero_of_head?
          (hR 1).2.1 (show 0 < (R 1).length by omega)
        simpa [hk1one] using hhead
      have hr1Rb : (R 1)[k1]'hk1R = b 1 := by
        have hlast := Workspace.ProofLemmas.PathBasics.getElem_last_of_getLast?
          (hR 1).2.2 (show 0 < (R 1).length by omega)
        simpa only [hk1one, hR1eq, Nat.reduceSub] using hlast
      obtain ⟨c, hfc⟩ := List.length_eq_one_iff.mp hfone
      have hcf1 : c = f₁ := by
        apply Option.some_injective
        simpa only [hfc, List.head?_cons] using hf.2.1
      have hcfn : c = fn := by
        apply Option.some_injective
        simpa only [hfc, List.getLast?_singleton] using hf.2.2
      have hf1fn : f₁ = fn := hcf1.symm.trans hcfn
      have hfa0 : G.Adj f₁ (a 0) := by simpa only [hr0La] using hf1r0L
      have hfb0 : G.Adj f₁ (b 0) := by simpa only [hr0Rb] using hf1r0R
      have hfa1 : G.Adj f₁ (a 1) := by rw [hf1fn]; simpa only [hr1La] using hfnr1L
      have hfb1 : G.Adj f₁ (b 1) := by rw [hf1fn]; simpa only [hr1Rb] using hfnr1R
      have hmajor : MajorForPrism G a b f₁ := by
        unfold MajorForPrism SaturatesPrism
        constructor
        · have hsub : ({a 0, a 1} : Set V) ⊆
              ({a 0, a 1, a 2} : Set V) ∩ G.neighborSet f₁ := by
            intro q hq
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq ⊢
            rcases hq with rfl | rfl
            · exact ⟨Or.inl rfl, (SimpleGraph.mem_neighborSet G f₁ (a 0)).mpr hfa0⟩
            · exact ⟨Or.inr (Or.inl rfl),
                (SimpleGraph.mem_neighborSet G f₁ (a 1)).mpr hfa1⟩
          calc
            2 = ({a 0, a 1} : Set V).ncard :=
              (Set.ncard_pair (hA 0 1 (by decide)).ne).symm
            _ ≤ (({a 0, a 1, a 2} : Set V) ∩ G.neighborSet f₁).ncard :=
              Set.ncard_le_ncard hsub
        · have hsub : ({b 0, b 1} : Set V) ⊆
              ({b 0, b 1, b 2} : Set V) ∩ G.neighborSet f₁ := by
            intro q hq
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq ⊢
            rcases hq with rfl | rfl
            · exact ⟨Or.inl rfl, (SimpleGraph.mem_neighborSet G f₁ (b 0)).mpr hfb0⟩
            · exact ⟨Or.inr (Or.inl rfl),
                (SimpleGraph.mem_neighborSet G f₁ (b 1)).mpr hfb1⟩
          calc
            2 = ({b 0, b 1} : Set V).ncard :=
              (Set.ncard_pair (hB 0 1 (by decide)).ne).symm
            _ ≤ (({b 0, b 1, b 2} : Set V) ∩ G.neighborSet f₁).ncard :=
              Set.ncard_le_ncard hsub
      exact (hfNonmajor f₁ (List.mem_of_mem_head? hf.2.1)) hmajor
  have hleftE : Even leftLen := hleftEven hleft4
  have hright4 : 4 ≤ rightLen := by
    by_contra hnot
    have hright3 : rightLen = 3 := by
      dsimp only [rightLen] at hnot ⊢
      omega
    have htot : (leftLen + rightLen) % 2 = 0 := by
      rw [hsum, ← Nat.even_iff]
      exact htotalEven
    rw [Nat.even_iff] at hleftE
    omega
  have hrightE : Even rightLen := hrightEven hright4
  have hpTrack : trackLength p = f.length := by
    simp only [trackLength]
    omega
  have hpPar : (k0 + trackLength p) % 2 = k1 % 2 := by
    rw [Nat.even_iff] at hleftE
    dsimp only [leftLen] at hleftE
    rw [hpTrack]
    omega
  have htrackR : ∀ i : Fin 3, trackLength (Q i) = (R i).length := by
    intro i
    have hi := hΘ.2.1 i
    simp only [trackLength]
    omega
  have hQpar : ∀ i : Fin 3,
      trackLength (Q i) % 2 = trackLength (Q 0) % 2 := by
    intro i
    fin_cases i
    · rfl
    · change trackLength (Q 1) % 2 = trackLength (Q 0) % 2
      rw [htrackR 1, htrackR 0]
      exact hRlenPar01.symm
    · change trackLength (Q 2) % 2 = trackLength (Q 0) % 2
      rw [htrackR 2, htrackR 0]
      exact hRlenPar02.symm
  exact thetaExtension_isBipartite_of_parity Θ x y Q hΘ.1 z z' k0 k1 hk0 hk1 hzpos hz'pos
    H ρ p hext hQpar hpPar

/-- Public parity criterion for a theta branch extension.  This is the structural core used by
`Thm101ThetaBipartite`, exposed for later constructions whose theta is not obtained from a
prism. -/
theorem thetaExtensionIsBipartiteOfParity {m m' : ℕ}
    (Θ : SimpleGraph (Fin m)) (x y : Fin m) (Q : Fin 3 → List (Fin m))
    (hΘ : IsThetaDatum Θ x y Q)
    (z z' : Fin m) (k0 k1 : ℕ)
    (hk0 : k0 < (Q 0).length) (hk1 : k1 < (Q 1).length)
    (hzpos : (Q 0)[k0]'hk0 = z) (hz'pos : (Q 1)[k1]'hk1 = z')
    (H : SimpleGraph (Fin m')) (ρ : Fin m → Fin m') (p : List (Fin m'))
    (hext : IsThetaBranchExtension Θ z z' H ρ p)
    (hQpar : ∀ i : Fin 3, trackLength (Q i) % 2 = trackLength (Q 0) % 2)
    (hpPar : (k0 + trackLength p) % 2 = k1 % 2) :
    H.IsBipartite :=
  thetaExtension_isBipartite_of_parity Θ x y Q hΘ z z' k0 k1 hk0 hk1 hzpos hz'pos
    H ρ p hext hQpar hpPar

end Workspace.ProofLemmas
